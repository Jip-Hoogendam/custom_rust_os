use core::{alloc::GlobalAlloc, ptr::null_mut};

use crate::allocator::Locked;

#[global_allocator]
static ALLOCATOR: Locked<BinaryBuddy> = Locked::new(BinaryBuddy::new());

#[derive(Default)]
pub struct BinaryBuddy {
    pub start: *mut BuddyBlock,
    pub size: usize,
}

#[derive(Default)]
struct BuddyBlock {
    pub size: usize,
    pub free: bool,
}

impl BinaryBuddy {
    pub const fn new() -> Self {
        BinaryBuddy { start: null_mut(), end: null_mut() }
    }

    ///initilizes the allocator.
    ///
    ///#Safety
    ///
    ///Caller must garuntee that the allocator points to a valid virtual memory adress.
    unsafe fn init(&mut self, start: *mut BuddyBlock, size: usize) {
        self.start = start;
        self.size = size;
    }


    find_best_block(&self)

    ///finds the next usable block.
    ///
    ///# Safety
    ///
    ///Caller must garuntee that the pointer is to a valid BuddyBlock.
    unsafe fn next_block(block: *mut BuddyBlock) -> *mut BuddyBlock {
        unsafe { block.add((*block).size) }
    }

    ///splits the block into the 2 smaller blocks
    fn split_block(block: *mut BuddyBlock, size: usize) -> *mut BuddyBlock {
        if block.is_null() && size != 0 {
            unsafe {
                while size < (*block).size / 2 {
                    let new_size = (*block).size / 2;
                    (*block).size = new_size;
                    let new_block = BinaryBuddy::next_block(block);
                    (*new_block).size = new_size;
                    (*new_block).free = true;
                }
            }
            block
        } else {
            null_mut()
        }
    }
}

unsafe impl GlobalAlloc for Locked<BinaryBuddy> {
    unsafe fn alloc(&self, layout: core::alloc::Layout) -> *mut u8 {
        null_mut()
    }

    unsafe fn dealloc(&self, ptr: *mut u8, layout: core::alloc::Layout) {
        panic!("dealloc shuld never be called idiot :3");
    }
}
