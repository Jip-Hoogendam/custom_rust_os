use x86_64::VirtAddr;

pub mod apic;
pub mod madt;
pub mod sdt;
use madt::MADT;
use sdt::{SDP, SDT, SDTHeader};

use crate::{acpi::sdt::ShortSDTHeader, println};

#[derive(Debug)]
#[non_exhaustive]
#[repr(u32, C)]
pub enum SDTables {
    /// # Multiple APIC Discriptor Table.
    /// This table contains all the information of each (I/O) APIC.
    ///
    /// This signature is adjusted to `APIC`.
    MADT(MADT) = u32::from_be_bytes(*b"APIC"),
    /// # Boot grapics Resource Table.
    ///
    /// Holds data about the displayed image during boot.
    BGRT(ShortSDTHeader) = u32::from_be_bytes(*b"BGRT"),
    DTST(ShortSDTHeader) = u32::from_be_bytes(*b"DTST"),
    FADT(ShortSDTHeader) = u32::from_be_bytes(*b"FACP"), // signature: FACP
    /// #Root System Discriptor table.
    ///
    /// This is here for completeness.
    /// Holds refrences to all other discriptor tables.
    RSDT(ShortSDTHeader) = u32::from_be_bytes(*b"RSDT"),
    SRAT(ShortSDTHeader) = u32::from_be_bytes(*b"SRAT"),
    SSDT(ShortSDTHeader) = u32::from_be_bytes(*b"SSDT"),
    /// # Extended Root System Discriptor Table.
    ///
    /// This is here for completeness.
    /// Holds refrences to all other discriptor tables.
    XSDT(ShortSDTHeader) = u32::from_be_bytes(*b"XSDT"),

    /// Not yet defined by me
    UNKOWN(ShortSDTHeader),
}

impl<'a> SDTables {
    #[inline]
    pub fn load(adress: u64) -> Result<&'a Self, SDTLoadErrors> {
        let header = unsafe { SDTHeader::load(adress)? };
        println!(
            "Header: {} : APIC as u32 : {}",
            unsafe { *(header as *const SDTHeader).cast::<u32>() },
            u32::from_be_bytes(*b"BGRT")
        );
        Ok(header.cast::<SDTables>())
    }
}

// Errors reeturd when loading the sdt
#[derive(Debug)]
pub enum SDTLoadErrors {
    InvalidChecksum,
}

/// Loads the acpi tables.
///
/// # Safety
/// This requires that the provided rsdp pointer is pointing at the adress of the rsdp
pub unsafe fn load_dsp_table(rsdp_ptr: u64, phys_mem_offset: VirtAddr) {
    println!("Loading SDP");
    let sdp = unsafe { SDP::load_sdp(rsdp_ptr, phys_mem_offset) };
    println!("SDP loaded!\nLoading SDT");

    let sdt = SDT::load(sdp, phys_mem_offset).expect("Failed to load SDT");
    println!("SDT Loaded!\n SDT: {:?}", sdt);

    for table in sdt.tables_iter(phys_mem_offset.as_u64()) {
        println!("{:?}", table);
        if let SDTables::MADT(mdat) = table {
            for record in mdat.records() {
                println!("Record: {:?}", record);
            }
        }
    }
}
